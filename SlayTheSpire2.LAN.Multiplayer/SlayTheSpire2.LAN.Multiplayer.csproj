<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Keep in sync with mod.json so the loader log identifies the build. -->
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
    <GodotProjectDir>$(MSBuildProjectDirectory)</GodotProjectDir>
    <!-- Override in Directory.Build.props: <STS2GameDir>path/to/data_sts2_windows_x86_64</STS2GameDir> -->
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">D:\Slay the Spire 2\data_sts2_windows_x86_64</STS2GameDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Godot.SourceGenerators" Version="4.5.1" />
  </ItemGroup>

  <!--
    The mod ships loose localization JSON (has_pck=false) and LocalizationFixService reads it
    from the directory the assembly lives in. Copy it next to the DLL so the build output is a
    complete, installable mod folder - without this every mod loc key throws a LocException.
  -->
  <ItemGroup>
    <None Include="..\mod.json" CopyToOutputDirectory="PreserveNewest" Link="mod.json" />
    <None Include="..\mod_image.png" CopyToOutputDirectory="PreserveNewest" Link="mod_image.png" />
    <None Include="..\localization\**\*.json" CopyToOutputDirectory="PreserveNewest"
          Link="localization\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(STS2GameDir)\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDir)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
